{
  "manifest_version": 3,
  "name": "JD Filler",
  "version": "1.5.0",
  "description": "Score jobs with Claude, autofill applications from your profile or the edge tab, and log to Notion.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.notion.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "Open JD Filler",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+J",
        "mac": "Command+Shift+J"
      },
      "description": "Open the JD Filler side panel"
    }
  },
  "options_ui": {
    "page": "profile.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "edge-tab.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
